{
  "schemaVersion": 39,
  "title": "Fleet health",
  "uid": "fleet-health",
  "description": "Imported operational dashboard",
  "tags": ["ops", "fleet"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "utc",
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "prod,staging",
        "options": [
          { "text": "prod", "value": "prod", "selected": true },
          { "text": "staging", "value": "staging", "selected": false }
        ],
        "current": { "text": "prod", "value": "prod" },
        "multi": false,
        "includeAll": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "uid": "prom", "type": "prometheus" },
        "query": { "query": "label_values(up, instance)" },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "deploys",
        "datasource": { "uid": "loki", "type": "loki" },
        "query": "{job=\"deploy\"}",
        "enable": true,
        "iconColor": "#60a5fa"
      }
    ]
  },
  "links": [
    { "title": "Runbooks", "url": "/d/runbooks", "type": "dashboards" }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": [
        {
          "id": 1,
          "type": "timeseries",
          "title": "Latency p95",
          "description": "Request latency",
          "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
          "datasource": { "uid": "prom", "type": "prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.95, rate(latency_bucket{env=\"$env\"}[$__rate_interval]))",
              "legendFormat": "p95 {{instance}}",
              "interval": "30s",
              "maxDataPoints": 2000
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.99, rate(latency_bucket{env=\"$env\"}[$__rate_interval]))",
              "legendFormat": "p99",
              "instant": false
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ms",
              "decimals": 2,
              "min": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 250 },
                  { "color": "red", "value": 500 }
                ]
              },
              "mappings": [
                { "type": "value", "options": { "value": "0", "text": "none" } }
              ],
              "color": { "mode": "thresholds" },
              "links": [
                { "title": "Traces", "url": "/traces?from=$__from", "targetBlank": true }
              ]
            },
            "overrides": [
              {
                "matcher": { "id": "byRegexp", "options": "^p99" },
                "properties": [
                  { "id": "color", "value": { "mode": "fixed", "fixedColor": "#ef4444" } },
                  { "id": "custom.lineWidth", "value": 3 }
                ]
              }
            ]
          },
          "options": {
            "legend": { "show": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
            "tooltip": { "mode": "multi" }
          },
          "transformations": [
            { "id": "reduce", "options": { "reducers": ["lastNotNull"] } },
            { "id": "filterByValue", "options": { "filters": [{ "fieldName": "p95" }] } },
            { "id": "futureTransform", "options": { "keep": true } }
          ]
        },
        {
          "id": 2,
          "type": "stat",
          "title": "Errors",
          "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
          "targets": [
            { "refId": "A", "expr": "sum(rate(errors_total{env=\"$env\"}[5m]))" }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "decimals": 1,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "red", "value": 5 }
                ]
              },
              "color": { "mode": "thresholds" }
            }
          },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
        },
        {
          "id": 3,
          "type": "gauge",
          "title": "CPU",
          "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
          "targets": [
            { "refId": "A", "expr": "avg(system_cpu_percent{env=\"$env\"})" }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "thresholds": {
                "mode": "percentage",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 70 },
                  { "color": "red", "value": 90 }
                ]
              }
            }
          },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showValue": true }
        },
        {
          "id": 4,
          "type": "table",
          "title": "Instances",
          "gridPos": { "x": 0, "y": 9, "w": 12, "h": 6 },
          "targets": [
            { "refId": "A", "expr": "up{env=\"$env\"}", "format": "table", "instant": true }
          ]
        },
        {
          "id": 5,
          "type": "text",
          "title": "Runbook",
          "gridPos": { "x": 12, "y": 9, "w": 6, "h": 6 },
          "options": { "content": "If p95 is above 500ms, page the on-call." }
        },
        {
          "id": 6,
          "type": "future-panel",
          "title": "Future",
          "gridPos": { "x": 18, "y": 9, "w": 6, "h": 6 }
        }
      ]
    }
  ]
}
