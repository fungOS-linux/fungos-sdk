{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fungos.dev/schemas/action-intent.schema.json",
  "title": "Spore UI action intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "payload": {
      "type": ["object", "null"]
    }
  }
}
